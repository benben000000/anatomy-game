{
  "name": "muscle-atlas",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Muscle Atlas — an offline-first anatomy study instrument for the muscular system, built for iPad Safari.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "dev:3d": "vite --mode private3d",
    "build": "npm run typecheck && vite build",
    "build:release": "npm run typecheck && vite build --mode release",
    "preview": "vite preview --port 4173",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "validate:content": "tsx scripts/validate-content.ts",
    "build:3d-derivatives": "tsx scripts/build-3d-derivatives.ts",
    "verify:3d-assets": "tsx scripts/verify-3d-assets.ts",
    "validate:icons": "node scripts/generate-icons.mjs",
    "validate:all": "npm run lint && npm run typecheck && npm run validate:content && npm run test && npm run build && npm run test:e2e",
    "dev:3d:e2e": "vite --mode private3d --port 4199 --strictPort"
  },
  "dependencies": {
    "dexie": "^4.0.10",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.0",
    "three": "^0.180.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "@playwright/test": "^1.51.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.13.9",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^3.0.8",
    "eslint": "^9.22.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "fake-indexeddb": "^6.0.0",
    "globals": "^16.0.0",
    "jsdom": "^26.0.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.26.1",
    "vite": "^6.2.2",
    "vite-plugin-pwa": "^0.21.2",
    "vitest": "^3.0.8"
  }
}
