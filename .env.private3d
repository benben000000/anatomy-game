# Private local 3D mode.
#
# Loaded by `npm run dev:3d` (vite --mode private3d).
#
# This is NOT a build flag that ships anything. It only tells the running dev
# server that the owner wants local 3D available. Model binaries are served from
# private/assets/ by a dev-server plugin and are never copied into dist/, so no
# build can contain them regardless of this setting.
#
# The user must ALSO enable "Private 3D models" in Settings at runtime, so a
# shared machine never loads models by default.

VITE_PRIVATE_3D=true