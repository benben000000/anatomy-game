# Muscle Atlas — environment configuration
#
# Muscle Atlas is local-first and has no backend, no accounts, and no external
# service calls. Nothing here is a secret. Every variable is read at build time
# through Vite's VITE_ prefix.
#
# Copy to `.env.local` to override locally. `.env.local` is git-ignored.

# ------------------------------------------------------------------ #
# Safety-relevant build flags
#
# Both default to "on" in development and "off" in production. Turning them on
# in a release build is refused by vite.config.ts (`npm run build:release`).
# ------------------------------------------------------------------ #

# Allow structures with content_status draft or reviewed to be loaded.
# Required to exercise the demo content pack locally. Must be false to release.
VITE_ALLOW_DRAFT_CONTENT=true

# The anatomy illustration is development placeholder geometry, not reviewed
# medical artwork. Must be false to release.
VITE_PROVISIONAL_ART=true

# Developer tools: hit-region inspector, structure ID overlay, content
# validator panel, storage inspection. Stripped from release bundles.
VITE_ENABLE_DEBUG_TOOLS=true

# Optional timed challenge. Off by default; it is speed practice, not a
# measure of learning, and it is never enabled without an explicit opt-in.
VITE_ENABLE_TIMED_CHALLENGE=false
